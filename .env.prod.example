# Production Environment Configuration
# Copy this file to .env.prod and update values

# Django Settings
DEBUG=0
SECRET_KEY=generate-a-strong-secret-key-here

# Allowed hosts (your domain)
ALLOWED_HOSTS=your-domain.com,www.your-domain.com

# Database Settings
DB_NAME=vetclinic
DB_USER=vetclinic_user
DB_PASSWORD=use-a-very-strong-password-here

# Server Settings
SERVER_HOST=your-server-ip-or-domain
OPENROUTER_API_KEY=your-openrouter-api-key
NOOA_CHATBOT_MODEL=openai/z-ai/glm-4.5-air:free
NOOA_CHATBOT_API_BASE=https://openrouter.ai/api/v1
NOOA_CHATBOT_TIMEOUT_SECONDS=30
NOOA_CHATBOT_TOTAL_TIMEOUT_SECONDS=45
NOOA_CHATBOT_MAX_CONCURRENT_REQUESTS=2
CHATBOT_RATE_LIMIT_REQUESTS=10
CHATBOT_RATE_LIMIT_WINDOW_SECONDS=60
